# ===========================================
# LUXE PARFUMS - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in the values

# ----- SERVER -----
PORT=5000
NODE_ENV=development

# ----- MONGODB -----
# Local: mongodb://localhost:27017/luxury-perfume
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/luxury-perfume
MONGODB_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/luxury-perfume

# ----- JWT AUTH -----
# Generate a strong random string for production (use: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=7d

# ----- GMAIL OAUTH2 (Optional - for email functionality) -----
# Set up in Google Cloud Console > APIs & Services > Credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/auth/gmail/callback
GMAIL_REFRESH_TOKEN=

# ----- FRONTEND URL -----
# Update this to your frontend URL in production
FRONTEND_URL=http://localhost:5173

# ----- ADMIN EMAIL -----
ADMIN_EMAIL=admin@yourdomain.com

# ----- CLOUDINARY -----
# Get these from your Cloudinary Dashboard > Settings > API Keys
CLOUDINARY_APIKEY=your-api-key
CLOUDINARY_APISECRET=your-api-secret
